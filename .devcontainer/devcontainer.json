{
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "customizations": {
    "vscode": {
      "extensions": [
        "wokwi.wokwi-vscode",
        "platformio.platformio-ide"
      ],
      "settings": {
        "platformio-ide.useBuiltinPIOCore": true
      }
    }
  },
  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.platformio /home/vscode/.wokwi && sudo apt-get update && sudo apt-get install -y python3-venv && pip install --user platformio && curl -L https://wokwi.com/ci/install.sh | sh",
  "postStartCommand": "sudo chown -R vscode:vscode /home/vscode/.platformio /home/vscode/.wokwi",
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.platformio/penv/bin:/home/vscode/.local/bin:/home/vscode/.wokwi/bin",
    "WOKWI_CLI_TOKEN": "${localEnv:WOKWI_CLI_TOKEN}"
  },
  "mounts": [
    "source=pio-cache,target=/home/vscode/.platformio,type=volume",
    "source=wokwi-cache,target=/home/vscode/.wokwi,type=volume"
  ]
}
